  "narrative": {
    "northStar": "The Contact Desk",
    "overview": "A calm contact desk in the existing IndianRenters visual identity. Mona Sans, charcoal text, white space and yellow accents make actions easy to distinguish; thin rules organize practical details. This record applies only to the contact demo and does not replace the storefront or parent brand system.",
    "keyCharacteristics": [
      "Generous heading scale with compact supporting labels.",
      "Flat neutral surfaces and ruled rows.",
      "Pill actions and intent controls; softly rounded fields."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use yellow for primary actions and brief emphasis; use charcoal for selected intent and directory states.",
        "section": "colors"
      },
      {
        "name": "The Heading First Rule",
        "body": "Put the branch name before the office or service-city description. Keep metadata in supporting text.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate content with tone, whitespace and rules. Reserve the inherited soft button shadow for hover feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do inherit Mona Sans and the existing brand color variables.",
      "Do retain visible labels, native form controls and visible keyboard focus.",
      "Do stack the form and branch content on narrow screens; keep editable control text at 16px.",
      "Do use the supplied city illustrations and outline SVG icons."
    ],
    "donts": [
      "Don't promote the demo notice or confirmation copy into reusable brand messaging.",
